{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["src/**", "scripts/**", "*.ts", "*.json", "!src/generated", "!**/package-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Accumulators like `(best ??= x)` and `n += (a = f())` are deliberate in the pixel loops.
        "noAssignInExpressions": "off",
        // `xs.forEach((x) => set.add(x))` is idiomatic here; the returned value is ignored on purpose.
        "useIterableCallbackReturn": "off"
      },
      "style": {
        // `!` marks a fact the code checked earlier (see docs/typescript.md); a cast would say less.
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": { "enabled": true }
}
