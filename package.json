{
  "name": "colormeris-site",
  "version": "0.1.0",
  "private": true,
  "description": "The Colormeris colormap viewer (GitHub Pages site) and the colormeris npm package (packages/core).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:core": "rm -rf packages/core/dist && tsc -p packages/core/tsconfig.json",
    "pack:core": "npm run build:core && npm pack ./packages/core --pack-destination packages/core",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:core",
    "perf": "node scripts/perf/run.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
