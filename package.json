{
  "name": "colormeris",
  "version": "0.1.0",
  "private": true,
  "description": "Static web app that turns colors in scientific figures back into numbers (heatmap, ROI and map tools) and browses colormaps.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests && node --test \"tests/**/*.test.js\"",
    "test:watch": "vitest",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "npm run lint && npm run typecheck && npm test",
    "proxy": "node scripts/openrouter-proxy.mjs",
    "docs": "node scripts/agent-docs.mjs",
    "fixtures": "node scripts/make-calibration.mjs"
  },
  "dependencies": {
    "@openrouter/sdk": "1.4.10",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
