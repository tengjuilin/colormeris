{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "colormeris",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8000
    },
    {
      "name": "colormeris-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec npx vite --port \"${PORT:-8002}\""
      ],
      "port": 8002,
      "autoPort": true
    },
    {
      "name": "openrouter-proxy",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/openrouter-proxy.mjs"
      ],
      "port": 8787
    },
    {
      "name": "colormeris-build",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run -s build && exec npx vite preview --port 8004"
      ],
      "port": 8004
    }
  ]
}
